:root,
:root[data-theme="dark"] {
  --bg: #07070d !important;
  --bg-2: #0c0c1a !important;
  --bg-3: #11111e !important;
  --surface: rgba(18, 17, 31, .82) !important;
  --surface-2: rgba(29, 27, 46, .78) !important;
  --border: rgba(255,255,255,.12) !important;
  --border-2: rgba(255,255,255,.16) !important;
  --text: #f5f3ff !important;
  --text-dim: #c2bdd2 !important;
  --muted: #938ba5 !important;
}
html, body { min-height: 100%; }
body {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif !important;
  color: #f5f3ff !important;
  background:
    radial-gradient(circle at 15% 15%, rgba(99,102,241,.18), transparent 34%),
    radial-gradient(circle at 82% 18%, rgba(236,72,153,.14), transparent 36%),
    linear-gradient(135deg, #07070d 0%, #11101b 45%, #1c101a 100%) !important;
  background-attachment: fixed !important;
}
body::before { background: transparent !important; }
body::after { background: transparent !important; }
.lang-menu, .language-menu, select, select option {
  color-scheme: dark !important;
  background-color: #0c0c1a !important;
  color: #f5f3ff !important;
  border-color: rgba(255,255,255,.16) !important;
}
.lang-menu, .language-menu { box-shadow: 0 16px 40px rgba(0,0,0,.45) !important; }
.lang-btn, .language-btn { color: #c2bdd2 !important; }
.lang-btn:hover, .language-btn:hover, .lang-btn.sel, .language-btn.active { color: #fff !important; border-color: #ec4899 !important; }
