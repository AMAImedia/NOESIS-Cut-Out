# NOESIS public repository ignore rules
# The portable runtime downloads/bootstraps heavy components locally.

# OS and editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.vscode/
.idea/

# Python caches and local build output
__pycache__/
*.py[cod]
*.pyd
*.so
*.tmp
*.temp
*.cache
.cache/
runtime_pycache/

# Logs, diagnostics and internal development material
*.log
logs/
dev/
backup/
samples/
root_*.txt
*_audit.*
*_test.*
intentional_error_test*
stability_*
cycle_*
current_*
server_*
help.*

# Local user state and downloaded output
downloads/
output/
settings.json
history.jsonl
client_cache.json
*.jsonl

# Authentication and credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
cookies.txt
cookies/
**/cookies/

# Verification markers and local manifests generated by bootstrap
.verified
vendor/.verified
engine/vendor/.verified

# Heavy portable runtime/model payloads are delivered separately
models/
vendor/models/
engine/vendor/models/
vendor/python/
engine/vendor/python/
venv/
ComfyUI/
engine/vendor/bin/
vendor/bin/

# Large archives and local downloads
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.whl

# Local publication/archive folders
_NOESIS_*

# Keep the public entrypoints and source assets tracked explicitly:
# START.bat, index.html, README.md, LICENSE, docs/, runtime/, vendor/ (lightweight assets)
